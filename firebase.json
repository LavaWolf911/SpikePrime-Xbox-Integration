{
  "hosting": {
    "public": "website/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/learn",
        "destination": "/learn/learn.html"
      },
      {
        "source": "/home",
        "destination": "/home/index.html"
      }
    ]


  }
}
