{
  "hosting": {
    "public": "website/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/home", "destination": "/index.html" },
      { "source": "/learn/**", "destination": "/index.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
